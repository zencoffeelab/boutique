{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zen-coffee-lab",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "main": "./workers/app.ts",
  "routes": [
    {
      "pattern": "zencoffeelab.com",
      "custom_domain": true
    },
    {
      "pattern": "www.zencoffeelab.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "ALLOW_DEMO_DATA": "false",
    "PAYMENTS_MOCK": "false",
    "SHIPPING_MOCK": "false",
    "DEMO_ADMIN": "false",
    "SHIP_FROM_NAME": "Zen Coffee Lab",
    "SHIP_FROM_COMPANY": "Zen Coffee Lab",
    "SHIP_FROM_STREET1": "32 rue Louis Blanc",
    "SHIP_FROM_STREET2": "",
    "SHIP_FROM_CITY": "Tours",
    "SHIP_FROM_POSTAL_CODE": "37000",
    "SHIP_FROM_COUNTRY": "FR",
    "SHIP_FROM_PHONE": "+33612692079",
    "SHIP_FROM_EMAIL": "contact@zencoffeelab.com"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
