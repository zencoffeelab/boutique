{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zen-coffee-lab",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "keep_vars": true,
  "main": "./workers/app.ts",
  "routes": [
    {
      "pattern": "zencoffeelab.com",
      "custom_domain": true
    },
    {
      "pattern": "www.zencoffeelab.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
